# ThinkBloom LMS — shared backend environment file.
#
# Copy this to `.env` in the repo root. The API and the worker both read that
# one file (getEnvFilePath() walks up to the folder holding yarn.lock).
# The Next.js app is separate — see apps/web/.env.example.
#
# Never commit the real `.env`. Only this example file is tracked.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development

# API port. Code default is 8080, pm2 runs it on 3005.
PORT=3005

# Worker port. Code reads WORKER_PORT (not PORT), code default is 8081.
WORKER_PORT=3006

# Where the API is reachable. Used for AI summary callbacks and upload URLs.
APP_BASE_URL=http://localhost:3005

# Where the web app is reachable. Used to build links inside emails.
FRONTEND_URL=http://localhost:3002

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Required. Nothing starts without it — API, worker, seed and migration scripts
# all use it.
SYSTEM_DATABASE_URL=postgresql://user:password@localhost:5432/thinkbloom

# ── Auth ────────────────────────────────────────────────────────────────────
# Required. Set a long random string. If you leave it unset, tokens are signed
# with "12345" but verified with "", so every login fails.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ── AI (Google Gemini) ──────────────────────────────────────────────────────
# Needed for course summaries, the chatbot and video analysis.
GEMINI_API_KEY=

# ── Redis / BullMQ ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=1

# Set to the string "true" to connect over TLS. Anything else means no TLS.
REDIS_TLS_ENABLED=false

# Basic-auth login for the queue dashboard at /queues.
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ── File storage ────────────────────────────────────────────────────────────
# Set to "s3" to upload to AWS S3. Any other value stores files on local disk
# under ./uploads.
STORAGE_PROVIDER=local

# Only used when STORAGE_PROVIDER=s3.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional. If set, file URLs are served through CloudFront instead of S3.
AWS_CLOUDFRONT_URL=
