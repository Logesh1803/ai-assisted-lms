# ThinkBloom LMS — web app environment file.
#
# Copy this to `apps/web/.env`. Backend config lives in the root `.env`.
# NEXT_PUBLIC_ vars are baked into the browser bundle at build time, so never
# put a secret here.

# Base URL of the API, including the /api/v1 prefix.
# This is the code default, so local dev works even without this file.
NEXT_PUBLIC_API_URL=http://localhost:3005/api/v1
